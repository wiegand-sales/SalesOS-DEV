{
  "manifest_version": 3,
  "name": "Sales OS – Deine Kennzahlen",
  "short_name": "Sales OS",
  "version": "1.0.0",
  "description": "Zeigt Vertriebsmitarbeitern der Wiegand GmbH ihre eigenen Kennzahlen und ihre vorläufige Provision aus Sales OS.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sales OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://nhudrbulfyampyyxhosv.supabase.co/*"
  ]
}